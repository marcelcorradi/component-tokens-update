{
  "name": "figma-plugin-template",
  "version": "0.1.0",
  "private": true,
  "description": "Starter for Figma plugins built with create-figma-plugin, with Claude Code skills included.",
  "dependencies": {
    "@create-figma-plugin/ui": "^4.0.3",
    "@create-figma-plugin/utilities": "^4.0.3",
    "preact": "^10.29.0"
  },
  "devDependencies": {
    "@create-figma-plugin/build": "^4.0.3",
    "@create-figma-plugin/tsconfig": "^4.0.3",
    "@figma/plugin-typings": "^1.140.0",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "build-figma-plugin --typecheck --minify",
    "watch": "build-figma-plugin --typecheck --watch",
    "lint": "tsc --noEmit"
  },
  "figma-plugin": {
    "editorType": [
      "figma"
    ],
    "id": "figma-plugin-template",
    "name": "Plugin Template",
    "main": "src/main.ts",
    "ui": "src/ui.tsx",
    "documentAccess": "dynamic-page",
    "networkAccess": {
      "allowedDomains": [
        "none"
      ]
    }
  }
}
